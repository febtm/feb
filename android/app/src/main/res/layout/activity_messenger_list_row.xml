<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@color/colorPrimaryTransparent77">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginRight="40dp"
        android:layout_marginEnd="40dp"
        tools:ignore="RtlHardcoded">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp">

                <ImageView
                    android:id="@+id/mes_i_useronline"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="5dp"
                    android:layout_gravity="start|center"
                    android:background="@drawable/mes_online"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    android:layout_marginStart="5dp" />

                <TextView
                    android:id="@+id/mes_i_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingEnd="45dp"
                    android:text="@string/username"
                    android:textColor="@color/colorSecondary"
                    android:textSize="16sp"
                    android:layout_marginLeft="20dp"
                    android:textStyle="bold"
                    tools:ignore="RtlSymmetry"
                    android:layout_marginStart="20dp"
                    android:paddingRight="45dp" />

                <ImageView
                    android:id="@+id/mes_i_userread"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center|end"
                    android:background="@drawable/app_ok"
                    android:contentDescription="@null"
                    android:visibility="visible" />

            </FrameLayout>

    <TextView
        android:id="@+id/mes_i_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:padding="5dp"
        android:textColor="@color/colorQuaternary"
        android:text="@string/timestamp"
        android:textSize="12sp"/>

</LinearLayout>

    <ImageButton
        android:id="@+id/mes_i_deletebutton"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="10dp"
        android:layout_gravity="center|end"
        android:background="@drawable/app_delete"
        android:layout_marginEnd="10dp"
        tools:ignore="RtlHardcoded"
        android:contentDescription="@null" />

</FrameLayout>