<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    android:background="@drawable/rp_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@android:color/transparent">

        <ImageButton
            android:id="@+id/rp_menu"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical"
            android:background="@drawable/app_menu"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:text="@string/recover_password"
            android:textSize="18sp"
            android:textColor="@color/colorSecondary" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/lsr_me_rec_pass"/>

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:contentDescription="@null"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/app_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/colorSecondary"
                    android:textStyle="bold|italic"
                    android:layout_marginBottom="30dp"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_enter_email"
                    android:textColor="@color/colorSecondary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="30dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@color/colorPrimaryTransparent77"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="20dp"
                    tools:ignore="RtlHardcoded">

                    <EditText
                        android:id="@+id/rp_email"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/email_id"
                        android:inputType="textEmailAddress"
                        android:background="@android:color/transparent"
                        android:padding="10dp"
                        android:paddingRight="30dp"
                        android:paddingEnd="30dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColorHint="@color/colorSecondary"
                        android:textColor="@color/colorSecondary"
                        tools:ignore="RtlSymmetry" />

                    <ImageButton
                        android:id="@+id/rp_email_cancel"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center|end"
                        android:background="@drawable/app_cancel"
                        android:layout_marginRight="5dp"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@null" />

                </FrameLayout>

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:id="@+id/rp_send_email"
                    android:text="@string/rp_send_email"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="20dp"
                    android:background="@color/colorSecondary" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>