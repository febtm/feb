<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/sm_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@android:color/transparent">

        <ImageButton
            android:id="@+id/sm_menu"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical"
            android:background="@drawable/app_menu"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:text="@string/social_media"
            android:textSize="18sp"
            android:textColor="@color/colorPrimary" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/me_soc_media"/>

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_margin="10dp">

        <LinearLayout
            android:id="@+id/sm_send_email"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:visibility="visible"
            android:background="@color/colorGmail">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="10dp"
                android:background="@drawable/sm_send_email"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sm_send_an_email"
                android:layout_margin="10dp"
                android:gravity="center"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sm_facebook_share"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:visibility="visible"
            android:background="@color/colorFacebook">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="10dp"
                android:background="@drawable/sm_facebook_share"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sm_facebook_share"
                android:layout_margin="10dp"
                android:gravity="center"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sm_twitter_share"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:visibility="visible"
            android:background="@color/colorTwitter">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="10dp"
                android:background="@drawable/sm_twitter_share"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sm_twitter_share"
                android:layout_margin="10dp"
                android:gravity="center"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sm_send_email_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/sm_from_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="10dp"
                    android:inputType="textEmailAddress|textMultiLine"
                    android:hint="@string/sm_from_email"
                    android:background="@color/colorSecondaryTransparent77"
                    android:textColorHint="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/colorPrimary"
                    android:paddingStart="5dp"
                    android:paddingEnd="40dp" />

                <ImageButton
                    android:id="@+id/sm_from_email_cancel"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center|end"
                    android:background="@drawable/app_cancel"
                    android:layout_marginRight="5dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/sm_to_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="10dp"
                    android:inputType="textEmailAddress|textMultiLine"
                    android:hint="@string/sm_to_email"
                    android:background="@color/colorSecondaryTransparent77"
                    android:textColorHint="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/colorPrimary"
                    android:paddingStart="5dp"
                    android:paddingEnd="40dp" />

                <ImageButton
                    android:id="@+id/sm_to_email_cancel"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center|end"
                    android:background="@drawable/app_cancel"
                    android:layout_marginRight="5dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null" />

            </FrameLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/sm_subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="10dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:hint="@string/sm_subject"
                    android:background="@color/colorSecondaryTransparent77"
                    android:textColorHint="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/colorPrimary"
                    android:paddingStart="5dp"
                    android:paddingEnd="40dp" />

                <ImageButton
                    android:id="@+id/sm_subject_cancel"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center|end"
                    android:background="@drawable/app_cancel"
                    android:layout_marginRight="5dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp">

                <EditText
                    android:id="@+id/sm_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="10dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:hint="@string/sm_message"
                    android:background="@color/colorSecondaryTransparent77"
                    android:textColorHint="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/colorPrimary"
                    android:paddingStart="5dp"
                    android:paddingEnd="40dp" />

                <ImageButton
                    android:id="@+id/sm_message_cancel"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center|end"
                    android:background="@drawable/app_cancel"
                    android:layout_marginRight="5dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null" />

            </FrameLayout>

            <Button
                android:id="@+id/sm_send"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/sm_send"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@color/colorSecondaryTransparent77"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sm_facebook_share_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/sm_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="10dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:hint="@string/sm_title"
                    android:background="@color/colorSecondaryTransparent77"
                    android:textColorHint="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/colorPrimary"
                    android:paddingStart="5dp"
                    android:paddingEnd="40dp" />

                <ImageButton
                    android:id="@+id/sm_title_cancel"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center|end"
                    android:background="@drawable/app_cancel"
                    android:layout_marginRight="5dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp">

                <EditText
                    android:id="@+id/sm_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="10dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:hint="@string/sm_description"
                    android:background="@color/colorSecondaryTransparent77"
                    android:textColorHint="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/colorPrimary"
                    android:paddingStart="5dp"
                    android:paddingEnd="40dp" />

                <ImageButton
                    android:id="@+id/sm_description_cancel"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center|end"
                    android:background="@drawable/app_cancel"
                    android:layout_marginRight="5dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null" />

            </FrameLayout>

            <Button
                android:id="@+id/sm_share"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/sm_share"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@color/colorSecondaryTransparent77"/>

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

</LinearLayout>