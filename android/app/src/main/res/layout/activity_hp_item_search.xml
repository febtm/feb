<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/colorPrimaryTransparent77"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:id="@+id/hp_i_s_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:maxLines="2"
        android:padding="5dp"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/colorSecondary" />

    <TextView
        android:id="@+id/hp_i_s_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:maxLines="3"
        android:padding="5dp"
        android:textColor="@color/colorSecondary" />

    </LinearLayout>

    <TextView
        android:id="@+id/hp_i_s_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSecondaryTransparent77"
        android:textSize="12sp"
        android:maxLines="1"
        android:textStyle="bold"
        android:padding="5dp"
        android:textColor="@color/colorSecondary" />

</LinearLayout>