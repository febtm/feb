<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/si_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="60dp"
            android:paddingBottom="20dp"
            android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/signin_background"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            >

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="@null"
                android:background="@drawable/app_logo"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/colorPrimary"
                android:layout_marginTop="20dp"
                android:textStyle="bold|italic"
                android:textSize="20sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/signin_edittext"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="60dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signin_sign_up"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:layout_marginBottom="30dp"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textColor="@color/colorPrimary"
                android:id="@+id/signin_username"
                android:maxLength="8"
                android:textStyle="bold"
                android:hint="@string/username"
                android:digits="@string/digits"
                android:layout_marginBottom="10dp"
                android:paddingRight="10dp"
                android:paddingLeft="10dp"
                android:textColorHint="@color/colorPrimary"
                android:background="@color/colorSecondaryTransparent77"
                android:textSize="15sp" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textColorHint="@color/colorPrimary"
                android:background="@color/colorSecondaryTransparent77"
                android:layout_marginBottom="10dp"
                android:textColor="@color/colorPrimary"
                android:inputType="textEmailAddress"
                android:ems="10"
                android:textStyle="bold"
                android:padding="10dp"
                android:id="@+id/signin_email"
                android:hint="@string/email_id"
                android:textSize="15sp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorSecondaryTransparent77"
                android:layout_marginBottom="10dp">

            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textColor="@color/colorPrimary"
                android:textColorHint="@color/colorPrimary"
                android:inputType="textPassword"
                android:background="@android:color/transparent"
                android:ems="10"
                android:paddingEnd="30dp"
                android:textStyle="bold"
                android:padding="10dp"
                android:id="@+id/signin_password"
                android:hint="@string/password"
                android:textSize="15sp"
                android:paddingRight="30dp" />

            <CheckBox
                android:id="@+id/signin_show_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|end"/>

            </FrameLayout>

            <Button
                android:id="@+id/signin_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:padding="10dp"
                android:background="@color/colorSecondaryTransparent77"
                android:layout_marginBottom="30dp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:text="@string/signin_tandc" />

        </LinearLayout>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textColor="@color/colorPrimary"
        android:text="@string/signin_sign_in"
        android:textStyle="bold"
        android:textSize="15sp"
        android:id="@+id/signin_register"
        android:background="@color/colorSecondaryTransparent77"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dip"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/colorPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/signin_sign_in_with"
        android:textColor="@color/colorPrimary"
        android:id="@+id/signin_with"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp">

    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/signin_facebook"
                android:contentDescription="@null"
                android:background="@drawable/si_facebook" />

            <com.facebook.login.widget.LoginButton
                android:visibility="gone"
                android:id="@+id/fb_login_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"/>

    </RelativeLayout>

    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="30dp"
        android:layout_height="30dp">

        <ImageButton
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/signin_google"
            android:contentDescription="@null"
            android:background="@drawable/si_google" />

        <com.google.android.gms.common.SignInButton
            android:visibility="gone"
            android:id="@+id/sign_in_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal" />

    </RelativeLayout>

    </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dip"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@color/colorPrimary"/>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>