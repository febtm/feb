<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/li_background"
    android:orientation="vertical"
    android:baselineAligned="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@android:color/transparent">

        <ImageButton
            android:id="@+id/li_menu"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical"
            android:background="@drawable/app_menu"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:text="@string/log_in"
            android:textSize="18sp"
            android:textColor="@color/colorSecondary" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/lsr_me_login"/>

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="@null"
                android:background="@drawable/app_logo"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/colorSecondary"
                android:textStyle="bold|italic"
                android:layout_marginBottom="30dp"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/li_enter_credentials"
                android:textColor="@color/colorSecondary"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="30dp"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/colorPrimaryTransparent77"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                tools:ignore="RtlHardcoded">

                <EditText
                    android:id="@+id/li_email"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/email_id"
                    android:inputType="textEmailAddress"
                    android:background="@android:color/transparent"
                    android:padding="10dp"
                    android:paddingRight="30dp"
                    android:paddingEnd="30dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColorHint="@color/colorSecondary"
                    android:textColor="@color/colorSecondary"
                    tools:ignore="RtlSymmetry" />

                <ImageButton
                    android:id="@+id/li_email_cancel"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center|end"
                    android:background="@drawable/app_cancel"
                    android:layout_marginRight="5dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/colorPrimaryTransparent77"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                tools:ignore="RtlHardcoded">

                <EditText
                    android:id="@+id/li_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:background="@android:color/transparent"
                    android:padding="10dp"
                    android:paddingRight="30dp"
                    android:paddingEnd="30dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColorHint="@color/colorSecondary"
                    android:textColor="@color/colorSecondary"
                    tools:ignore="RtlSymmetry" />

                <CheckBox
                    android:id="@+id/li_show_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|end"
                    android:layout_marginRight="30dp"
                    android:layout_marginEnd="30dp" />

                <ImageButton
                    android:id="@+id/li_password_cancel"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center|end"
                    android:background="@drawable/app_cancel"
                    android:layout_marginRight="5dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null" />

            </FrameLayout>


            <com.google.android.gms.ads.AdView
                android:id="@+id/li_adView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                ads:adSize="BANNER"
                android:layout_marginBottom="20dp"
                ads:adUnitId="@string/li_admob_banner">
            </com.google.android.gms.ads.AdView>


            <Button
                android:id="@+id/li_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_in"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                android:background="@color/colorSecondary"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>